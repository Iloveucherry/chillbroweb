@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  color-scheme: dark;
}

html, body {
  margin: 0;
  min-height: 100%;
  background: #020817;
  color: white;
  font-family: Arial, Helvetica, sans-serif;
}

body {
  background:
    radial-gradient(circle at top left, rgba(167, 139, 250, 0.2), transparent 30%),
    radial-gradient(circle at bottom right, rgba(16, 185, 129, 0.15), transparent 30%),
    #020817;
}

* {
  box-sizing: border-box;
}

button {
  cursor: pointer;
}
